rules_version = '2';

/*
  Уулзварын зайн хэмжилт — Firestore аюулгүй байдлын дүрэм

  Зарчим:
    • Нэвтрээгүй хүн юу ч уншиж, бичиж чадахгүй.
    • Хэрэглэгчийн эрх (ПД дугаар, role) нь ЗӨВХӨН users/{email} баримтад
      тодорхойлогдоно. Түүнийг апп-аас өөрчлөх боломжгүй (write: false) —
      зөвхөн Firebase Console-оос админ гараар үүсгэнэ.
    • Ажилтан зөвхөн ӨӨРИЙН илгээлтээ уншиж/бичнэ.
    • Админ зөвхөн ӨӨРИЙН ПД-ийн илгээлтүүдийг уншиж/устгана.
    • Хэн ч өөр ПД-ийн өгөгдөлд хүрэхгүй.

  Суулгах: Firebase Console → Firestore Database → Rules → энэ файлыг
  бүхэлд нь хуулж тавиад Publish дарна.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(myEmail())).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(myEmail()));
    }
    // active талбар байхгүй бол идэвхтэйд тооцно (.get-гүй бол дүрэм алдаа өгнө)
    function activeUser() {
      return hasProfile() && profile().get('active', true) != false;
    }
    /* ПД дугаарыг тоо болгож жигдрүүлнэ.
       Console дээр pd-г санамсаргүйгээр string ("6") болгож хадгалсан ч
       ажиллана — тоо болгож хөрвүүлээд харьцуулна. */
    function asPd(v) { return v is int ? v : int(v); }
    function myPd() { return asPd(profile().pd); }
    /* role-ийг том/жижиг үсэг, англи/монгол хамаарахгүйгээр таньна:
       "admin", "Admin", "ADMIN", "админ", "Админ", "АДМИН" — бүгд админ.
       Тайлбар: дүрмийн .lower() нь зөвхөн латин үсэгт ажилладаг тул
       кирилл хувилбаруудыг тусад нь бичив. */
    function isAdmin() {
      return activeUser() && (
        profile().role.lower() == 'admin'
        || profile().role == 'админ'
        || profile().role == 'Админ'
        || profile().role == 'АДМИН'
      );
    }

    /* ── Хэрэглэгчийн эрх ──
       Баримтын ID = цахим хаяг (жижиг үсгээр). Жишээ: pd6.bataa@uulzvar.mn
       Талбарууд: pd (1-13, тоо), role ('admin'|'worker'), name (текст),
                  active (true/false, заавал биш)                          */
    match /users/{email} {
      // Өөрийн бүртгэлээ уншина. Админ өөрийн ПД-ийн хүмүүсийг уншина.
      allow read: if signedIn() && (
                    email == myEmail() ||
                    (isAdmin() && asPd(resource.data.pd) == myPd())
                  );
      // Эрх олгох/өөрчлөхийг зөвхөн Firebase Console-оос хийнэ.
      allow write: if false;
    }

    /* ── Хэмжилтийн илгээлтүүд ──
       Баримтын ID = {uid}__{sessionId}                                     */
    match /measurements/{docId} {

      function mine() {
        return resource.data.email == myEmail();
      }
      // Бичиж буй өгөгдөл өөрийн ПД, өөрийн хаягтай таарч байгаа эсэх
      function validNew() {
        return request.resource.data.pd == myPd()
            && request.resource.data.email == myEmail()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.pd is int
            && request.resource.data.count is int
            && validId()
            && validSpan();
      }
      /* Баримтын ID нь ЗААВАЛ «{uid}__{sessionId}» бөгөөд зөвхөн үсэг, тоо,
         «_», «-» агуулна.
         Яагаад: ID нь админы хуудсанд HTML-ийн inline handler дотор орж ирдэг.
         «'» зэрэг тэмдэгт агуулсан ID-тай баримтыг ажилтан бичиж чадвал админ
         тэр баримтыг нээхэд JavaScript ажиллах (хадгалагдсан XSS) боломж үүснэ.
         Аппын өөрийн үүсгэдэг ID (sess_<цаг>_<санамсаргүй>) энэ хэлбэрт таарна. */
      function validId() {
        return request.resource.data.sessionId is string
            && docId == request.auth.uid + '__' + request.resource.data.sessionId
            && docId.matches('[A-Za-z0-9_-]{1,200}');
      }
      /* Км-ийн муж: тоо, e ≥ s, нийт ≤ 1000. Хязгааргүй бол «for km=s..e»
         давталттай клиент (админ) царцдаг. Өртөөний зам s=e=0. */
      function validSpan() {
        return request.resource.data.s is number
            && request.resource.data.e is number
            && request.resource.data.e >= request.resource.data.s
            && request.resource.data.e - request.resource.data.s <= 1000;
      }

      allow read:   if activeUser() && (mine() || (isAdmin() && asPd(resource.data.pd) == myPd()));
      allow create: if activeUser() && validNew();
      // Зөвхөн өөрийн илгээлтээ шинэчилнэ. ПД, хаяг, uid-г солих боломжгүй.
      allow update: if activeUser() && mine() && validNew()
                    && request.resource.data.pd == resource.data.pd
                    && request.resource.data.uid == resource.data.uid;
      /* Хугацаа (30 хоног) дууссан эсэх. Firestore-ийн TTL бодлого тохируулаагүй
         үед ажилтан өөрийн хуучин баримтыг апп-аараа цэвэрлэж чадна. */
      function expired() {
        return resource.data.get('expireAt', request.time + duration.value(1, 'd')) < request.time
            || resource.data.get('updatedAt', request.time) < request.time - duration.value(30, 'd');
      }
      /* Устгах: тухайн ПД-ийн админ (юуг ч), эсвэл ажилтан ӨӨРИЙН ХУГАЦАА ДУУССАН баримтыг. */
      allow delete: if (isAdmin() && asPd(resource.data.pd) == myPd())
                    || (activeUser() && mine() && expired());
    }

    // Бусад бүх зам хаалттай.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
